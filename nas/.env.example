#   cp .env.example .env && chmod 600 .env
# .env 는 .gitignore 에 걸려 있습니다. 절대 커밋하지 마세요.

# Supabase (config.js 와 동일한 값)
SUPABASE_URL="https://mcrpvchaluruwsagbawk.supabase.co"
SUPABASE_ANON_KEY="sb_publishable_10ShjYOhmxP1Lcgs-X4mEg_-u0Egf5k"

# 앱에 로그인할 때 쓰는 계정 (Supabase Authentication > Users 에 만든 그 계정)
MEDS_EMAIL="you@example.com"
MEDS_PASSWORD=""

# ntfy 토픽 — 이름이 곧 비밀번호다. 아래 값은 이번에 새로 생성한 것이니 그대로 쓰면 된다.
# 남에게 공유하지 말 것. 바꾸려면 아이폰 ntfy 앱의 구독도 같이 바꿔야 한다.
NTFY_TOPIC="meds-d674114fe7910a56e923e94d"

# 선택 — 기본값을 쓰려면 그대로 두세요
# NTFY_SERVER="https://ntfy.sh"
